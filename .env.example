# Configuración general
EVENTO_NOMBRE="BONO CONTRIBUCIÓN para la construcción de la Sede Social"
NUMERO_MIN=0
NUMERO_MAX=99
PRECIO_NUMERO=1000

# Datos de pago
PAGO_ALIAS=barrio.carolina.pagos
PAGO_CBU=0000003100010000000000
PAGO_TITULAR=Comisión Vecinal Barrio Carolina II
PAGO_BANCO=Mercado Pago / Banco

# Administradores (separados por coma, sin '+' ni espacios, ej: 5491112345678,5491187654321)
ADMIN_PHONES=

# ID del grupo de WhatsApp (obtenerlo escribiendo !idgrupo en el chat del grupo)
GRUPO_ID=

# Horarios de recordatorios automáticos (Formato Cron, ej: 0 11,19 * * * es a las 11:00 y 19:00 hs)
CRON_RECORDATORIO="0 11,19 * * *"
RECORDATORIOS_ACTIVOS=true

# Token de Mercado Pago (para generar links de pago automáticos, opcional)
MP_ACCESS_TOKEN=

# Inteligencia Artificial para lectura automática de comprobantes de pago
# Opción 1: Groq con Llama 3.2 Vision (100% Gratis, recomendada)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=

# Opción 2: Google Gemini AI
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=
AUTO_APROBAR_COMPROBANTES=true

# Configuración del Webhook para auto-confirmar pagos de Mercado Pago
PORT=3000
WEBHOOK_URL=http://146.181.32.71:3000/webhook/mercadopago

# Premios y Modalidad del Sorteo
FECHA_SORTEO="Sábado 25 de Octubre (o al completar los números)"
MODALIDAD_SORTEO="Se sortea con la Quiniela Nocturna de San Juan / Nacional (últimas 2 cifras)."
PREMIOS="🥇 1° Premio: $50.000 en efectivo\n🥈 2° Premio: 1 Cordero + 2 Vinos\n🥉 3° Premio: Canasta Familiar"
